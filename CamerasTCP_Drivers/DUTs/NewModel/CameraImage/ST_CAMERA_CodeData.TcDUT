<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_CAMERA_CodeData" Id="{034ffefa-305b-498f-bbca-2083db2824ff}">
    <Declaration><![CDATA[TYPE ST_CAMERA_CodeData :
STRUCT
	nScannerIndex		: INT;			(* scanner index when an array of scanners is used *)
	sDataString			: T_MaxString;	(* data string read from code *)
	eCodeType			: E_CAMERA_CodeType;	(* code type *)
	fOverallGrade		: LREAL;		(* overall grade of code *)
	fXPos				: LREAL;		(* X position of centre of code *)
	fYPos				: LREAL;		(* Y position of centre of code *)
	fAngle				: LREAL;		(* angle of code *)
	fCellSize			: LREAL;		(* cell size *)
	fSymbolContrast		: LREAL;		(* symbol contrast *)
	nEvaluation			: INT;			(* general code quality evaluatio*)
	fUnusedErrCorr		: LREAL;		(* unused error correction *)
	nProgramNo			: BYTE;			(* program number *)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>